# Required
DATABASE_URL="mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority"
BETTER_AUTH_SECRET="<generate-a-random-secret-with-at-least-32-characters>"
BETTER_AUTH_URL="https://<your-backend-host>"
FRONTEND_URL="https://<your-frontend-host>"

# Required for Razorpay payments (Test Mode credentials for testing)
RAZORPAY_KEY_ID="rzp_test_<key-id>"
RAZORPAY_KEY_SECRET="<razorpay-key-secret>"
RAZORPAY_WEBHOOK_SECRET="<webhook-secret-configured-in-razorpay>"

# Required for password recovery and transactional email
RESEND_API_KEY="re_<api-key>"
RESEND_FROM_EMAIL="Store name <verified-sender@example.com>"

# Required for product/avatar uploads
UPLOADTHING_TOKEN="<uploadthing-token>"

# Optional: Google OAuth
GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"

# Optional: Ask AI and seller AI insights
GEMINI_API_KEY="<gemini-api-key>"

# Platform-provided or local defaults
NODE_ENV="production"
PORT="5000"
